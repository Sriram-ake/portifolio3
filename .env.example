# ==============================================================================
# A Sri Ram Developer Portfolio — Environment Variables
# Copy this file to `.env` and fill in your real credentials.
# NEVER commit the `.env` file to version control.
# ==============================================================================

# Server configuration
PORT=5173
FRONTEND_URL=http://localhost:5173

# --- Brevo Transactional Email Integration ---
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=A Sri Ram Portfolio Contact Form
CONTACT_RECEIVER_EMAIL=akesurekha@gmail.com

# --- Rate Limiting ---
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=3600

# --- Coding Profiles (Verified Defaults) ---
GITHUB_USERNAME=Sriram-ake
LEETCODE_USERNAME=akesriram
CODECHEF_USERNAME=akesriram_2007
CODEFORCES_USERNAME=Sriram_2007
HACKERRANK_USERNAME=akesurekha
